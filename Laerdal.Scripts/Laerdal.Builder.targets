<?xml version="1.0" encoding="utf-8"?>

<!--                                                                                                                                    -->
<!--  Local build (macOS only):                                                                                                         -->
<!--                                                                                                                                    -->
<!--      dotnet msbuild Laerdal.Scripts/Laerdal.Builder.targets /m:1                                                                   -->
<!--                                                                                                                                    -->
<!--  To specify an explicit version:                                                                                                    -->
<!--                                                                                                                                    -->
<!--      dotnet msbuild Laerdal.Scripts/Laerdal.Builder.targets /m:1 /p:Laerdal_Version_Full=4.16.0.0                                  -->
<!--                                                                                                                                    -->
<!--  Notes:                                                                                                                            -->
<!--    - Requires macOS with Xcode and Carthage installed (brew install carthage)                                                      -->
<!--    - If Carthage fails, clear the cache:  rm -rf ~/Library/Caches/org.carthage.CarthageKit                                        -->
<!--    - Pass your GitHub token for Carthage:  /p:Laerdal_Github_Access_Token=<token>                                                  -->
<!--                                                                                                                                    -->
<Project DefaultTargets="BuildProjects">

    <PropertyGroup>
        <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>

        <RootFolderPath>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine($(MSBuildThisFileDirectory), '..'))))</RootFolderPath>

        <PackageOutputPath Condition=" '$(PackageOutputPath)' == '' ">$([System.IO.Path]::Combine($(RootFolderPath), 'Artifacts/'))</PackageOutputPath>
        <PackageOutputPath>$([System.IO.Path]::GetFullPath('$(PackageOutputPath)'))</PackageOutputPath>

        <Laerdal_Project_iOS>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine($(RootFolderPath), 'Laerdal.Dfu.Bindings.iOS', 'Laerdal.Dfu.Bindings.iOS.csproj'))))</Laerdal_Project_iOS>
        <Laerdal_Project_iOSSimulator_x64>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine($(RootFolderPath), 'Laerdal.Dfu.Bindings.iOSSimulator.x64', 'Laerdal.Dfu.Bindings.iOSSimulator.x64.csproj'))))</Laerdal_Project_iOSSimulator_x64>
        <Laerdal_Project_iOSSimulator_Arm64>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine($(RootFolderPath), 'Laerdal.Dfu.Bindings.iOSSimulator.Arm64', 'Laerdal.Dfu.Bindings.iOSSimulator.Arm64.csproj'))))</Laerdal_Project_iOSSimulator_Arm64>
        <Laerdal_Project_MacCatalyst>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine($(RootFolderPath), 'Laerdal.Dfu.Bindings.MacCatalyst', 'Laerdal.Dfu.Bindings.MacCatalyst.csproj'))))</Laerdal_Project_MacCatalyst>

        <Laerdal_Script_FolderPath>$(MSBuildThisFileDirectory)</Laerdal_Script_FolderPath>

        <!-- version: {Nordic_Package_Version}.{build_number}   override with /p:Laerdal_Version_Full=... -->
        <Nordic_Package_Version Condition=" '$(Nordic_Package_Version)' == '' ">4.17.0</Nordic_Package_Version>
        <Laerdal_Revision Condition=" '$(Laerdal_Revision)' == '' and '$(GITHUB_RUN_NUMBER)' != '' ">$([MSBuild]::Add(43857, $(GITHUB_RUN_NUMBER)))</Laerdal_Revision>
        <Laerdal_Revision Condition=" '$(Laerdal_Revision)' == '' ">0</Laerdal_Revision>
        <Laerdal_Version_Full     Condition=" '$(Laerdal_Version_Full)'     == '' ">$(Nordic_Package_Version).$(Laerdal_Revision)</Laerdal_Version_Full>
        <Laerdal_Version_Assembly Condition=" '$(Laerdal_Version_Assembly)' == '' ">$(Laerdal_Version_Full)</Laerdal_Version_Assembly>

        <!--                                                                                                                                          -->
        <!-- Xcode / SDK settings — set these here for local builds, or pass them on the command line                                                 -->
        <!--                                                                                                                                          -->
        <!-- <Laerdal_Bindings_iOS___Sdk_Version Condition="        '$(Laerdal_Bindings_iOS___Sdk_Version)'        == '' ">18.1</Laerdal_Bindings_iOS___Sdk_Version>                          -->
        <!-- <Laerdal_Bindings_iOS___Xcode_Ide_Dev_Path Condition=" '$(Laerdal_Bindings_iOS___Xcode_Ide_Dev_Path)' == '' ">/Applications/Xcode.app/Contents/Developer</Laerdal_Bindings_iOS___Xcode_Ide_Dev_Path> -->
        <!-- <Laerdal_Bindings_MacCatalyst___Sdk_Version Condition="        '$(Laerdal_Bindings_MacCatalyst___Sdk_Version)'        == '' ">15.1</Laerdal_Bindings_MacCatalyst___Sdk_Version>  -->
        <!-- <Laerdal_Bindings_MacCatalyst___Xcode_Ide_Dev_Path Condition=" '$(Laerdal_Bindings_MacCatalyst___Xcode_Ide_Dev_Path)' == '' ">/Applications/Xcode.app/Contents/Developer</Laerdal_Bindings_MacCatalyst___Xcode_Ide_Dev_Path> -->
    </PropertyGroup>

    <Target Name="BuildProjects">
        <Error Condition=" '$(Configuration)'              == '' " Text="'Configuration' must be set." />
        <Error Condition=" '$(PackageOutputPath)'          == '' " Text="'PackageOutputPath' must be set." />
        <Error Condition=" '$(Laerdal_Project_iOS)'        == '' " Text="'Laerdal_Project_iOS' must be set." />
        <Error Condition=" '$(Laerdal_Project_MacCatalyst)' == '' " Text="'Laerdal_Project_MacCatalyst' must be set." />
        <Error Condition=" '$(Laerdal_Project_iOSSimulator_x64)' == '' " Text="'Laerdal_Project_iOSSimulator_x64' must be set." />
        <Error Condition=" '$(Laerdal_Project_iOSSimulator_Arm64)' == '' " Text="'Laerdal_Project_iOSSimulator_Arm64' must be set." />

        <PropertyGroup>
            <_Params>Configuration=$(Configuration)</_Params>
            <_Params>$(_Params);PackageOutputPath=$(PackageOutputPath)</_Params>
            <_Params>$(_Params);Laerdal_Version_Full=$(Laerdal_Version_Full)</_Params>
            <_Params>$(_Params);Laerdal_Github_Access_Token=$(Laerdal_Github_Access_Token)</_Params>
            <_Params>$(_Params);Laerdal_Bindings_iOS___Sdk_Version=$(Laerdal_Bindings_iOS___Sdk_Version)</_Params>
            <_Params>$(_Params);Laerdal_Bindings_iOS___Xcode_Ide_Dev_Path=$(Laerdal_Bindings_iOS___Xcode_Ide_Dev_Path)</_Params>
            <_Params>$(_Params);Laerdal_Bindings_MacCatalyst___Sdk_Version=$(Laerdal_Bindings_MacCatalyst___Sdk_Version)</_Params>
            <_Params>$(_Params);Laerdal_Bindings_MacCatalyst___Xcode_Ide_Dev_Path=$(Laerdal_Bindings_MacCatalyst___Xcode_Ide_Dev_Path)</_Params>
        </PropertyGroup>

        <!-- [warning] EnsureFrameworkFolderIsCreated must be called first and separately — otherwise nugets are poisoned with missing native symbols -->
        <MSBuild Projects="$(Laerdal_Project_iOS)"              Targets="EnsureFrameworkFolderIsCreated" Properties="$(_Params)"/>
        <MSBuild Projects="$(Laerdal_Project_iOS)"              Targets="Restore"  Properties="$(_Params)"/>
        <MSBuild Projects="$(Laerdal_Project_iOS)"              Targets="Rebuild"  Properties="$(_Params);CleanNativeFolder=true;BuildingProject=true"/>

        <MSBuild Projects="$(Laerdal_Project_iOSSimulator_Arm64)" Targets="EnsureFrameworkFolderIsCreated" Properties="$(_Params)"/>
        <MSBuild Projects="$(Laerdal_Project_iOSSimulator_Arm64)" Targets="Restore"  Properties="$(_Params)"/>
        <MSBuild Projects="$(Laerdal_Project_iOSSimulator_Arm64)" Targets="Rebuild"  Properties="$(_Params);BuildingProject=true"/>

        <MSBuild Projects="$(Laerdal_Project_iOSSimulator_x64)"   Targets="EnsureFrameworkFolderIsCreated" Properties="$(_Params)"/>
        <MSBuild Projects="$(Laerdal_Project_iOSSimulator_x64)"   Targets="Restore"  Properties="$(_Params)"/>
        <MSBuild Projects="$(Laerdal_Project_iOSSimulator_x64)"   Targets="Rebuild"  Properties="$(_Params);BuildingProject=true"/>

        <MSBuild Projects="$(Laerdal_Project_MacCatalyst)"        Targets="EnsureFrameworkFolderIsCreated" Properties="$(_Params)"/>
        <MSBuild Projects="$(Laerdal_Project_MacCatalyst)"        Targets="Restore"  Properties="$(_Params)"/>
        <MSBuild Projects="$(Laerdal_Project_MacCatalyst)"        Targets="Rebuild"  Properties="$(_Params);BuildingProject=true"/>
    </Target>

</Project>
